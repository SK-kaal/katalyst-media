# Optional public site config
# NEXT_PUBLIC_SITE_URL=https://www.katalystmedia.co.uk
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourhandle
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/yourcompany

# Supabase (required for private campaign portal)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Preferred: server-only service role for admin data after access-code auth
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Access-code login (server-only — never use NEXT_PUBLIC_ for these)
ADMIN_ACCESS_CODE=replace-with-a-long-random-code
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-chars

# Only needed if SUPABASE_SERVICE_ROLE_KEY is not set.
# Server signs into this staff account after a valid access code (never exposed to the browser UI).
# ADMIN_SUPABASE_EMAIL=admin@example.com
# ADMIN_SUPABASE_PASSWORD=replace-me

# Soundcharts API (server-only — never use NEXT_PUBLIC_ for these)
# OAuth client credentials: exchanged for a Bearer access token at
# https://account.soundcharts.com/oauth/token (grant_type=client_credentials).
# Do not use the legacy x-app-id / x-api-key headers with these values.
SOUNDCHARTS_CLIENT_ID=your-soundcharts-client-id
SOUNDCHARTS_CLIENT_SECRET=your-soundcharts-client-secret

# Playwright / E2E
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
